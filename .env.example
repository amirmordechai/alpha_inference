# Google Cloud & Official AlphaEvolve Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GE_APP_ID="your-gemini-enterprise-app-id"
GCP_REGION="us-central1"
GCP_AR_REPO="alpha-inference-images"

# Optional: AlphaEvolve Gemini ensemble weights (must keep Pro <= 0.50)
AE_MODEL_1="gemini-3.5-flash"
AE_MODEL_1_WEIGHT="0.55"
AE_MODEL_2="gemini-3.1-pro-preview"
AE_MODEL_2_WEIGHT="0.45"
